{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "configMigration": true,
  "extends": [
    "config:recommended",
    "group:all"
  ],
  "mode": "full",
  "addLabels": [
    "renovate"
  ],
  "timezone": "America/Chicago",
  "html": {
    "managerFilePatterns": [
      "/\\.html?$/"
    ]
  },
  "npm": {
    "fileMatch": [
      "frontend/package\\.json$"
    ]
  }
}
